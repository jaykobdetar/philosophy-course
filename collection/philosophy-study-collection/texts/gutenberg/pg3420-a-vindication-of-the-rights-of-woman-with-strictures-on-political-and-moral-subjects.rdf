      <pgterms:agent rdf:about="2009/agents/84">
        <pgterms:name>Wollstonecraft, Mary</pgterms:name>
        <pgterms:birthdate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1759</pgterms:birthdate>
        <pgterms:deathdate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1797</pgterms:deathdate>
        <pgterms:alias>Cresswick, Mr.</pgterms:alias>
